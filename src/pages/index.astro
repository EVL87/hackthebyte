---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Collect unique tags
const allTags = [...new Set(sortedPosts.flatMap((post) => post.data.tags || []))].slice(0, 10);
---

<BaseLayout>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-backdrop">
      <picture>
        <source srcset="/images/hacker-lab-banner.webp" type="image/webp" />
        <img
          src="/images/hacker-lab-banner.png"
          alt="Hack the Byte Hacker Lab Workstation"
          class="hero-img"
        />
      </picture>
      <div class="hero-overlay"></div>
    </div>

    <div class="hero-content">
      <div class="hero-badge">
        <span class="badge-dot"></span> SEC OPS & RESEARCH LAB
      </div>
      <h1 class="hero-title">
        Descifrando la seguridad, <br /><span class="title-highlight">byte a byte</span>
      </h1>
      <p class="hero-description">
        Espacio donde la ciberseguridad se encuentra con el conocimiento práctico:
        análisis de vulnerabilidades, técnicas de evasión perimetral, writeups ofensivos sin Metasploit y detección en SOC.
      </p>

      <div class="hero-stats">
        <div class="stat-pill">
          <span class="stat-num">{sortedPosts.length}</span>
          <span class="stat-label">Artículos Técnicos</span>
        </div>
        <div class="stat-pill">
          <span class="stat-icon">🛡️</span>
          <span class="stat-label">Red & Blue Team</span>
        </div>
        <div class="stat-pill">
          <span class="stat-icon">⚡</span>
          <span class="stat-label">Cloudflare Edge Fast</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <div class="main-container">
    <div class="section-header">
      <div>
        <h2 class="section-title">Investigaciones y Writeups</h2>
        <p class="section-subtitle">Casos prácticos de laboratorio, análisis de tráfico y vectores de explotación</p>
      </div>
    </div>

    <!-- Tag Filter Bar -->
    <div class="tags-filter">
      <span class="filter-label">Filtrar por tema:</span>
      <div class="tag-chips">
        <button class="tag-chip active" data-tag="all">Todos ({sortedPosts.length})</button>
        {allTags.map((tag) => (
          <button class="tag-chip" data-tag={tag}>
            {tag}
          </button>
        ))}
      </div>
    </div>

    <!-- Posts Grid -->
    <div class="posts-grid" id="posts-grid">
      {sortedPosts.map((post) => {
        const slug = post.slug || post.id.replace(/\.(md|mdx)$/, '');
        const dateStr = post.data.pubDate.toLocaleDateString('es-ES', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
        });
        const tagsJson = JSON.stringify(post.data.tags || []);

        return (
          <article class="post-card" data-tags={tagsJson}>
            <a href={`/posts/${slug}`} class="card-image-link">
              <div class="card-image-wrap">
                <img
                  src={post.data.heroImage || '/images/hacker-lab-banner.webp'}
                  alt={post.data.title}
                  loading="lazy"
                  class="card-image"
                />
                <span class="card-category">{post.data.category || 'Ciberseguridad'}</span>
              </div>
            </a>

            <div class="card-body">
              <div class="card-meta">
                <time datetime={post.data.pubDate.toISOString()}>{dateStr}</time>
                <span class="meta-dot">•</span>
                <span>Por {post.data.author || 'EVLBYTE'}</span>
              </div>

              <h3 class="card-title">
                <a href={`/posts/${slug}`}>{post.data.title}</a>
              </h3>

              <p class="card-excerpt">{post.data.description}</p>

              <div class="card-footer">
                <div class="card-tags">
                  {(post.data.tags || []).slice(0, 3).map((t: string) => (
                    <span class="mini-tag">#{t}</span>
                  ))}
                </div>
                <a href={`/posts/${slug}`} class="read-more">
                  Leer artículo <span>→</span>
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
  /* Hero Styles */
  .hero-section {
    position: relative;
    padding: 6.5rem 1.5rem 5.5rem;
    overflow: hidden;
    background: #0a0c10;
    border-bottom: 1px solid var(--border-color);
  }

  .hero-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    overflow: hidden;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    filter: brightness(0.72) contrast(1.1);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(10, 12, 16, 0.2) 0%,
      rgba(10, 12, 16, 0.5) 60%,
      #0a0c10 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 1280px;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: #fca5a5;
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.35);
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 1.25rem;
    letter-spacing: 0.05em;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--accent-red);
    box-shadow: 0 0 8px var(--accent-red);
    display: inline-block;
  }

  .hero-title {
    font-size: clamp(2rem, 4vw + 1rem, 3.5rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
    max-width: 900px;
  }

  .title-highlight {
    background: linear-gradient(135deg, #ef4444 0%, #f43f5e 50%, #fb7185 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-description {
    font-size: 1.12rem;
    color: var(--text-secondary);
    max-width: 720px;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .stat-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(22, 27, 34, 0.8);
    border: 1px solid var(--border-color);
    padding: 0.5rem 1rem;
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 0.88rem;
  }

  .stat-num {
    color: var(--accent-red);
    font-weight: 700;
  }

  .stat-label {
    color: var(--text-secondary);
  }

  /* Main Container */
  .main-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
    width: 100%;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 1rem;
  }

  .section-title {
    font-size: 1.85rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.02em;
  }

  .section-subtitle {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin-top: 0.25rem;
  }

  /* Tags filter */
  .tags-filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
    background: var(--bg-surface);
    padding: 1rem 1.25rem;
    border-radius: 10px;
    border: 1px solid var(--border-color);
  }

  .filter-label {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .tag-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-chip {
    background: #181f2c;
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    font-size: 0.82rem;
    font-family: var(--font-mono);
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tag-chip:hover {
    color: #ffffff;
    border-color: rgba(239, 68, 68, 0.4);
  }

  .tag-chip.active {
    background: rgba(239, 68, 68, 0.2);
    border-color: var(--accent-red);
    color: #ffffff;
    font-weight: 600;
  }

  /* Posts Grid - Full 3 columns on wide screens */
  .posts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 640px) {
    .posts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .posts-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .post-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .post-card:hover {
    transform: translateY(-4px);
    border-color: rgba(239, 68, 68, 0.4);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5), 0 0 15px rgba(239, 68, 68, 0.15);
  }

  .card-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #0f131a;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .post-card:hover .card-image {
    transform: scale(1.05);
  }

  .card-category {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: rgba(10, 12, 16, 0.85);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #fca5a5;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    letter-spacing: 0.05em;
  }

  .card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-meta {
    font-size: 0.82rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.65rem;
    font-family: var(--font-mono);
  }

  .meta-dot {
    color: var(--border-color);
  }

  .card-title {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 0.75rem;
    color: #ffffff;
  }

  .card-title a {
    color: #ffffff;
  }

  .card-title a:hover {
    color: var(--accent-red);
  }

  .card-excerpt {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    flex: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color);
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .mini-tag {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .read-more {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-red);
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    transition: gap 0.15s ease;
  }

  .read-more:hover {
    gap: 0.45rem;
  }
</style>

<script>
  // Tag filtering logic
  const buttons = document.querySelectorAll('.tag-chip');
  const cards = document.querySelectorAll('.post-card');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      const selectedTag = btn.getAttribute('data-tag');

      cards.forEach((card) => {
        if (selectedTag === 'all') {
          (card as HTMLElement).style.display = 'flex';
          return;
        }

        const tagsAttr = card.getAttribute('data-tags') || '[]';
        try {
          const tags: string[] = JSON.parse(tagsAttr);
          if (tags.includes(selectedTag!)) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        } catch {
          (card as HTMLElement).style.display = 'flex';
        }
      });
    });
  });
</script>
